/* Welcome Header */
.welcome-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  animation: fadeInDown 0.6s ease-out;
}

.welcome-text h1.welcome-title {
  font-size: 42px;
  font-weight: 900;
  margin: 0 0 8px 0;
  color: white;
  letter-spacing: -0.5px;
}

.gradient-text {
  background: linear-gradient(135deg, #9333ea 0%, #fb923c 50%, #e879f9 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 3s ease-in-out infinite;
  background-size: 200% 200%;
}

.welcome-subtitle {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.7);
  margin: 0;
  font-weight: 400;
}

.profile-quick-info {
  display: flex;
  align-items: center;
  gap: 16px;
}

.profile-mini-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 3px solid rgba(147, 51, 234, 0.5);
  object-fit: cover;
  transition: all 0.3s ease;
}

.profile-mini-avatar:hover {
  border-color: rgba(147, 51, 234, 1);
  transform: scale(1.05);
}

.edit-profile-link {
  padding: 12px 28px;
  background: linear-gradient(135deg, #9333ea, #fb923c);
  color: white;
  text-decoration: none;
  border-radius: 16px;
  font-weight: 700;
  font-size: 14px;
  border: none;
  transition: all 0.3s ease;
  box-shadow: 0 6px 20px rgba(147, 51, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.edit-profile-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.edit-profile-link:hover::before {
  left: 100%;
}

.edit-profile-link:hover {
  background: linear-gradient(135deg, #a855f7, #fb923c);
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(147, 51, 234, 0.5);
}

/* ========================================
   MAIN DASHBOARD GRID LAYOUT
   ======================================== */

.dashboard-main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 32px;
  animation: fadeInUp 0.6s ease-out 0.2s both;
}

/* Balance Card - LEFT SIDE, COMPACT */
.balance-card {
  background: linear-gradient(135deg, rgba(147, 51, 234, 0.12) 0%, rgba(249, 115, 22, 0.08) 100%);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(147, 51, 234, 0.3);
  border-radius: 24px;
  padding: 32px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 15px 40px rgba(147, 51, 234, 0.2);
  transition: all 0.3s ease;
}

.balance-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(147, 51, 234, 0.25);
  border-color: rgba(147, 51, 234, 0.5);
}

.wallet-hero-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(147, 51, 234, 0.4) 0%, transparent 70%);
  filter: blur(80px);
  animation: pulse 4s ease-in-out infinite;
  pointer-events: none;
}

.wallet-hero-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 35px 90px rgba(147, 51, 234, 0.3);
  border-color: rgba(147, 51, 234, 0.5);
}

.wallet-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  position: relative;
  z-index: 1;
}

.wallet-label {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 18px;
  font-weight: 600;
  color: white;
}

.wallet-icon {
  font-size: 28px;
}

.wallet-status {
  padding: 8px 20px;
  border-radius: 24px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.wallet-status.active {
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
}

.wallet-status.inactive {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: white;
  box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
}

/* Balance Display - HERO ELEMENT */
.balance-display {
  text-align: center;
  margin: 60px auto;
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.balance-label {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.7);
  margin: 0 0 16px 0;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.balance-amount {
  font-size: 96px;
  font-weight: 900;
  margin: 0;
  background: linear-gradient(135deg, #9333ea 0%, #fb923c 50%, #e879f9 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  animation: balanceGlow 2s ease-in-out infinite;
  text-shadow: 0 0 60px rgba(147, 51, 234, 0.5);
}

.balance-currency {
  font-size: 32px;
  color: rgba(255, 255, 255, 0.8);
  margin: 16px 0 0 0;
  font-weight: 700;
  letter-spacing: 4px;
}

/* Wallet Actions */
.wallet-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  margin-bottom: 40px;
  position: relative;
  z-index: 1;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 18px 36px;
  border-radius: 16px;
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  cursor: pointer;
  border: none;
  position: relative;
  overflow: hidden;
}

.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.action-btn:hover::before {
  left: 100%;
}

.action-btn.primary {
  background: linear-gradient(135deg, #9333ea 0%, #fb923c 100%);
  color: white;
  box-shadow: 0 12px 35px rgba(147, 51, 234, 0.4);
}

.action-btn.primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 50px rgba(147, 51, 234, 0.6);
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: white;
  border: 2px solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
}

.action-btn.secondary:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.4);
  transform: translateY(-2px);
}

.action-btn svg {
  width: 20px;
  height: 20px;
}

/* Wallet Info Footer */
.wallet-info-footer {
  display: flex;
  justify-content: center;
  gap: 40px;
  padding-top: 32px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
  z-index: 1;
}

.info-item {
  text-align: center;
}

.info-label {
  display: block;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 6px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.info-value {
  display: block;
  font-size: 15px;
  color: white;
  font-weight: 600;
}

/* Secondary Cards Grid */
.secondary-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 24px;
  margin-bottom: 32px;
}

.info-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 32px;
  transition: all 0.4s ease;
  animation: fadeInUp 0.6s ease-out both;
}

.info-card:nth-child(1) { animation-delay: 0.3s; }
.info-card:nth-child(2) { animation-delay: 0.4s; }

.info-card:hover {
  transform: translateY(-8px);
  background: linear-gradient(135deg, rgba(147, 51, 234, 0.08), rgba(249, 115, 22, 0.05));
  border-color: rgba(147, 51, 234, 0.4);
  box-shadow: 0 20px 60px rgba(147, 51, 234, 0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 20px;
  font-weight: 700;
  margin: 0;
  color: white;
}

.card-title svg {
  width: 24px;
  height: 24px;
  color: rgba(147, 51, 234, 0.8);
}

.plan-status {
  padding: 6px 14px;
  border-radius: 16px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.plan-status.active {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.plan-status.inactive {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.4);
}

.plan-status.terminated {
  background: rgba(156, 163, 175, 0.2);
  color: #9ca3af;
  border: 1px solid rgba(156, 163, 175, 0.4);
}

.subscription-details {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.detail-value {
  font-size: 14px;
  color: white;
  font-weight: 600;
}

.card-action-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: rgba(147, 51, 234, 0.9);
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.3s ease;
}

.card-action-link:hover {
  color: #9333ea;
  gap: 12px;
}

/* Quick Stats */
.quick-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
  animation: fadeInUp 0.6s ease-out 0.5s both;
}

.stat-card {
  background: linear-gradient(135deg, rgba(147, 51, 234, 0.1), rgba(249, 115, 22, 0.05));
  backdrop-filter: blur(20px);
  border: 1px solid rgba(147, 51, 234, 0.2);
  border-radius: 20px;
  padding: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: all 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-5px);
  border-color: rgba(147, 51, 234, 0.5);
  box-shadow: 0 15px 40px rgba(147, 51, 234, 0.2);
}

.stat-icon {
  font-size: 42px;
  flex-shrink: 0;
}

.stat-content {
  flex: 1;
}

.stat-label {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.6);
  margin: 0 0 6px 0;
  font-weight: 500;
}

.stat-value {
  font-size: 24px;
  font-weight: 800;
  margin: 0;
  color: white;
}

.stat-value a {
  color: rgba(147, 51, 234, 0.9);
  text-decoration: none;
  font-size: 16px;
  transition: all 0.3s ease;
}

.stat-value a:hover {
  color: #9333ea;
}

/* ========================================
   CASHBACK HERO SECTION - NEW FEATURE
   ======================================== */

.cashback-hero-section {
  width: 100%;
  margin: 40px 0;
  animation: fadeInUp 0.6s ease-out 0.6s both;
}

.cashback-hero-card {
  position: relative;
  background: linear-gradient(135deg, rgba(251, 146, 60, 0.15) 0%, rgba(147, 51, 234, 0.12) 100%);
  backdrop-filter: blur(30px);
  border: 2px solid rgba(251, 146, 60, 0.3);
  border-radius: 32px;
  padding: 48px;
  overflow: hidden;
  box-shadow: 0 25px 70px rgba(251, 146, 60, 0.25);
  transition: all 0.4s ease;
}

.cashback-hero-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 35px 90px rgba(251, 146, 60, 0.35);
  border-color: rgba(251, 146, 60, 0.5);
}

/* Animated Glow Orb */
.cashback-glow-orb {
  position: absolute;
  top: -100px;
  right: -100px;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(251, 146, 60, 0.4) 0%, transparent 70%);
  filter: blur(80px);
  animation: float 6s ease-in-out infinite;
  pointer-events: none;
}

/* Header Section */
.cashback-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 40px;
  position: relative;
  z-index: 1;
}

.cashback-icon-wrapper {
  position: relative;
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cashback-icon-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #fb923c, #f97316);
  border-radius: 20px;
  opacity: 0.2;
  animation: pulse 3s ease-in-out infinite;
}

.cashback-icon {
  font-size: 48px;
  position: relative;
  z-index: 1;
  animation: bounce 2s ease-in-out infinite;
}

.cashback-title-section {
  flex: 1;
}

.cashback-title {
  font-size: 32px;
  font-weight: 900;
  margin: 0 0 8px 0;
  background: linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.cashback-subtitle {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.7);
  margin: 0;
  font-weight: 500;
}

/* Amount Display */
.cashback-amount-display {
  text-align: center;
  margin: 48px 0;
  position: relative;
  z-index: 1;
}

.cashback-label {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  margin: 0 0 16px 0;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.cashback-amount {
  font-size: 72px;
  font-weight: 900;
  margin: 0 0 16px 0;
  background: linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  animation: gradientShift 3s ease-in-out infinite;
  background-size: 200% 200%;
  text-shadow: 0 0 60px rgba(251, 146, 60, 0.5);
}

.cashback-period {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.cashback-period .highlight {
  color: #fb923c;
  font-weight: 700;
}

/* Stats Grid */
.cashback-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 20px;
  margin: 40px 0;
  position: relative;
  z-index: 1;
}

.cashback-stat-item {
  display: flex;
  align-items: center;
  gap: 16px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  padding: 24px;
  transition: all 0.3s ease;
}

.cashback-stat-item:hover {
  transform: translateY(-5px);
  background: rgba(251, 146, 60, 0.1);
  border-color: rgba(251, 146, 60, 0.4);
  box-shadow: 0 15px 40px rgba(251, 146, 60, 0.2);
}

.cashback-stat-icon {
  font-size: 36px;
  flex-shrink: 0;
}

.cashback-stat-content {
  flex: 1;
}

.cashback-stat-value {
  font-size: 24px;
  font-weight: 800;
  color: white;
  margin: 0 0 4px 0;
}

.cashback-stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Progress Section */
.cashback-progress-section {
  position: relative;
  z-index: 1;
  margin: 40px 0 32px 0;
}

.cashback-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.cashback-progress-label {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.cashback-progress-percentage {
  font-size: 18px;
  color: #fb923c;
  font-weight: 800;
}

.cashback-progress-bar {
  position: relative;
  width: 100%;
  height: 16px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 12px;
}

.cashback-progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #fb923c, #f97316, #ea580c);
  border-radius: 12px;
  transition: width 1s ease;
  box-shadow: 0 0 20px rgba(251, 146, 60, 0.6);
}

.cashback-progress-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 50px;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3));
  animation: shimmer 2s infinite;
}

.cashback-milestone-text {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
  text-align: center;
}

/* Action Button */
.cashback-action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 18px 36px;
  background: linear-gradient(135deg, #fb923c, #f97316);
  border: none;
  border-radius: 16px;
  color: white;
  font-weight: 700;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  text-decoration: none;
  box-shadow: 0 12px 35px rgba(251, 146, 60, 0.4);
  position: relative;
  overflow: hidden;
  margin: 0 auto;
  display: flex;
  width: fit-content;
}

.cashback-action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.6s;
}

.cashback-action-btn:hover::before {
  left: 100%;
}

.cashback-action-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 50px rgba(251, 146, 60, 0.6);
}

/* Animations */
@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(400%);
  }
}

/* Legacy Profile Styles - Cleaned up but kept for compatibility */
.profile-header {
  margin-bottom: 20px;
  text-align: center;
}

.profile-header h2 {
  margin-bottom: 0;
  font-weight: 600;
}

.profile-avatar {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  margin-bottom: 10px;
  box-shadow: 0 0 10px 5px rgba(9, 8, 17, 0.1);
}

.profile-name {
  font-size: 1.5rem;
  color: #333;
}

.profile-status-role-container {
  display: flex;
  gap: 8px;
  justify-content: center;
  margin: 10px 0;
}

.active-profile,
.inactive-profile {
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
}

.active-profile {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.inactive-profile {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.user-role-box {
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 600;
  background: rgba(147, 51, 234, 0.2);
  color: #9333ea;
}

.details-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 10px;
  font-size: 12px;
  color: #666;
  margin-top: 10px;
}

.details-section-container {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: center;
}

.details-section-container p {
  margin: 0;
}

.details-section strong {
  font-weight: 500;
  color: #333;
}

/* Animations */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes gradientShift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes balanceGlow {
  0%, 100% {
    filter: drop-shadow(0 0 20px rgba(147, 51, 234, 0.4));
  }
  50% {
    filter: drop-shadow(0 0 40px rgba(249, 115, 22, 0.6));
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.4;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.1);
  }
}

/* Responsive Design */
@media (max-width: 1200px) {
  .balance-amount {
    font-size: 72px;
  }

  .welcome-title {
    font-size: 36px;
  }
}

@media (max-width: 992px) {
  .welcome-header {
    flex-wrap: wrap;
    gap: 16px;
  }

  .balance-amount {
    font-size: 64px;
  }

  .wallet-actions {
    flex-wrap: wrap;
  }

  .action-btn {
    flex: 1 1 calc(50% - 8px);
    min-width: 200px;
  }

  .secondary-cards-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .welcome-header {
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .profile-quick-info {
    width: 100%;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .welcome-title {
    font-size: 28px;
    line-height: 1.2;
  }

  .welcome-subtitle {
    font-size: 16px;
  }

  .balance-amount {
    font-size: 52px;
  }

  .balance-currency {
    font-size: 22px;
  }

  .balance-label {
    font-size: 14px;
  }

  .wallet-hero-card {
    padding: 28px 20px;
  }

  .wallet-actions {
    flex-direction: column;
    width: 100%;
  }

  .action-btn {
    width: 100%;
    justify-content: center;
    flex: 1 1 100%;
    padding: 16px 28px;
    font-size: 15px;
  }

  .secondary-cards-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .quick-stats {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .wallet-info-footer {
    flex-direction: column;
    gap: 16px;
  }

  .card-title {
    font-size: 18px;
  }

  .info-card {
    padding: 28px;
  }
}

@media (max-width: 480px) {
  .welcome-title {
    font-size: 24px;
  }

  .welcome-subtitle {
    font-size: 14px;
  }

  .balance-amount {
    font-size: 42px;
  }

  .balance-currency {
    font-size: 18px;
  }

  .balance-label {
    font-size: 12px;
  }

  .wallet-hero-card {
    padding: 24px 16px;
  }

  .wallet-card-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .action-btn {
    padding: 14px 24px;
    font-size: 14px;
  }

  .info-card {
    padding: 24px 20px;
  }

  .card-title {
    font-size: 16px;
    flex-wrap: wrap;
  }

  .stat-icon {
    font-size: 36px;
  }

  .stat-value {
    font-size: 20px;
  }

  .detail-label,
  .detail-value {
    font-size: 13px;
  }

  .profile-mini-avatar {
    width: 48px;
    height: 48px;
  }

  .edit-profile-link {
    padding: 8px 16px;
    font-size: 13px;
  }
}

@media (max-width: 375px) {
  .welcome-title {
    font-size: 22px;
  }

  .balance-amount {
    font-size: 36px;
  }

  .balance-currency {
    font-size: 16px;
  }

  .wallet-hero-card {
    padding: 20px 14px;
  }

  .action-btn {
    padding: 12px 20px;
    font-size: 13px;
  }
}

@media (max-width: 320px) {
  .welcome-title {
    font-size: 20px;
  }

  .balance-amount {
    font-size: 32px;
  }

  .balance-currency {
    font-size: 14px;
  }

  .balance-label {
    font-size: 11px;
  }
}

/* Cashback Responsive Design */
@media (max-width: 992px) {
  .cashback-stats-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .cashback-hero-card {
    padding: 32px 24px;
  }

  .cashback-header {
    flex-direction: column;
    text-align: center;
    gap: 16px;
  }

  .cashback-amount {
    font-size: 56px;
  }

  .cashback-title {
    font-size: 28px;
  }

  .cashback-stat-icon {
    font-size: 32px;
  }

  .cashback-stat-value {
    font-size: 20px;
  }
}

@media (max-width: 480px) {
  .cashback-hero-card {
    padding: 24px 20px;
  }

  .cashback-amount {
    font-size: 48px;
  }

  .cashback-title {
    font-size: 24px;
  }

  .cashback-icon {
    font-size: 40px;
  }

  .cashback-icon-wrapper {
    width: 64px;
    height: 64px;
  }

  .cashback-action-btn {
    padding: 16px 32px;
    font-size: 15px;
  }
}
